# Copy to .env and fill in. Never commit .env.

# --- LLM / embeddings ---
OPENAI_API_KEY=sk-...
# Optional, if using Claude for generation:
ANTHROPIC_API_KEY=sk-ant-...

# Embedding model (1536 dims). If you change model, update EMBED_DIM in config.py.
EMBED_MODEL=text-embedding-3-small
# Generation model:
GEN_PROVIDER=openai            # openai | anthropic
GEN_MODEL=gpt-4o-mini          # or claude-... if GEN_PROVIDER=anthropic

# --- Postgres + pgvector (Docker container below) ---
PG_HOST=localhost
PG_PORT=5434
PG_DB=ragdemo
PG_USER=rag
PG_PASSWORD=ragpass

# --- Jira (Eugene fills this) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...
